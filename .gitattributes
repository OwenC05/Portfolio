# Auto detect text files and perform LF normalization
* text=auto

# Preserve byte-bound portfolio evidence and its source snapshots across checkouts.
/.omx/** -text
/design/** -text
# Keep frozen challenge hashes intact when original evidence uses CRLF.
/design/assistant/challenge/** whitespace=cr-at-eol
# Raw Node failure output includes indented blank lines; preserve the transcript.
/design/assistant/challenge/candidate-tests-*.txt whitespace=cr-at-eol,-blank-at-eol
/components/studio/** -text
/app/studio/** -text
/app/globals.css -text
/lib/studio-content.ts -text
/lib/studio-contract.ts -text
/public/studio/** -text
/package.json -text
/package-lock.json -text
